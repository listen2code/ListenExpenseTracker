<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 红色品牌圆角底座 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E53935" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- 白色 L 造型品牌图标 -->
