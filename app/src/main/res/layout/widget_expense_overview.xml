<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- 左侧：月度预算与收支仪表看板 -->
    <LinearLayout
        android:id="@+id/widget_budget_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="13"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@drawable/widget_card_bg"
        android:padding="8dp">

        <!-- 标题行：月份与三态健康度徽章 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_month_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="9月支出" />

            <TextView
                android:id="@+id/widget_health_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_normal"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1.5dp"
                android:textColor="@color/widget_health_normal"
                android:textSize="9.5sp"
                android:textStyle="bold"
                tools:text="正常" />
        </LinearLayout>

        <!-- 当月总支出金额 (自适应缩小，禁止省略号截断) -->
        <TextView
            android:id="@+id/widget_spent_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="--"
            android:textColor="@color/widget_text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="19sp"
            android:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="19sp"
            app:autoSizeStepGranularity="1sp"
            tools:text="￥0.00" />

        <!-- 剩余预算提示 (自适应缩小，禁止省略号截断) -->
        <TextView
            android:id="@+id/widget_budget_remaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeMaxTextSize="11sp"
            app:autoSizeStepGranularity="1sp"
            tools:text="剩余 ￥5,000.00" />

        <!-- 水平预算消耗进度条 (三态独立对应不同色彩，由 RemoteViews 控制显隐，彻底杜绝反射异常) -->
        <ProgressBar
            android:id="@+id/widget_budget_progress_normal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_normal" />

        <ProgressBar
            android:id="@+id/widget_budget_progress_warning"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:progressDrawable="@drawable/widget_progress_warning" />

        <ProgressBar
            android:id="@+id/widget_budget_progress_over"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:progressDrawable="@drawable/widget_progress_over" />
    </LinearLayout>

    <!-- 右侧：4 大高频快捷分类按钮 (2x2 饱满矩阵) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="10"
        android:orientation="vertical">

        <!-- 第 1 行快捷分类：餐饮与交通 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_btn_food"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/widget_btn_food_bg"
                android:textColor="@color/widget_btn_food_text"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="🍔 餐饮" />

            <TextView
                android:id="@+id/widget_btn_transport"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/widget_btn_transport_bg"
                android:textColor="@color/widget_btn_transport_text"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="🚗 交通" />
        </LinearLayout>

        <!-- 第 2 行快捷分类：购物与日用 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_btn_shopping"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/widget_btn_shopping_bg"
                android:textColor="@color/widget_btn_shopping_text"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="🛍️ 购物" />

            <TextView
                android:id="@+id/widget_btn_daily"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/widget_btn_daily_bg"
                android:textColor="@color/widget_btn_daily_text"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="📦 日用" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
